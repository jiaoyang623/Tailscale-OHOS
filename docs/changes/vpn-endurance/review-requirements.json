  "layer": "requirements",
  "title": "连接常驻与省电 · 需求审核",
  "conclusion": "本层确认五件事：连接的停止条件、断连留证方式、恢复尝试策略、网络离线等待、省电档位。请逐项选择。",
  "decisions": [
    {
      "id": "D-01",
      "priority": "P0",
      "question": "连接什么时候可以停止？",
      "reason": "用户报告长时间使用后连接中断。现有逻辑以状态判读决定停止。一次读不到心跳就可能释放保护。",
      "options": [
        {
          "id": "A",
          "label": "只认用户停止",
          "description": "停止只由用户动作决定。状态缺失、陈旧、心跳停止都不停止连接。后台任务保留，恢复看门狗继续运行。",
          "consequences": "连接更稳。代价是进程常驻时间变长。",
          "recommended": true
        },
        {
          "id": "B",
          "label": "沿用状态判读",
          "description": "读到断开就释放长时任务。",
          "consequences": "省一点电。连接可能在用户不知情时停止。",
          "recommended": false
        }
      ],
      "recommendation": "A",
      "affected_design_ids": [
        "R-CONN-11",
        "R-CONN-09",
        "R-CONN-06",
        "R-CONN-13",
        "R-CONN-04",
        "R-CONN-05"
      ]
    },
    {
      "id": "D-02",
      "priority": "P0",
      "question": "非用户断连怎么留证？",
      "reason": "现有日志只有生命周期事件。无法区分用户停止、扩展崩溃、交接超时与系统停止。",
      "options": [
        {
          "id": "A",
          "label": "专用会话账本加受控原因词",
          "description": "每次会话结束写一行。字段固定。原因取自受控词表。账本有上限。",
          "consequences": "原因可统计。需要新增一个文件与写入点。",
          "recommended": true
        },
        {
          "id": "B",
          "label": "只扩展现有诊断事件",
          "description": "把原因写进现有诊断事件文件。",
          "consequences": "改动小。诊断事件会被探测噪声挤掉，断连记录可能丢失。",
          "recommended": false
        }
      ],
      "recommendation": "A",
      "affected_design_ids": [
        "R-CONN-12",
        "R-DIAG-05",
        "R-DIAG-02",
        "R-DIAG-03",
        "R-DIAG-01",
        "R-DIAG-04"
      ]
    },
    {
      "id": "D-03",
      "priority": "P1",
      "question": "恢复尝试要设上限吗？",
      "reason": "用户要求连接保持到用户停止。固定上限会让后台断连永久不恢复。",
      "options": [
        {
          "id": "A",
          "label": "不设上限，退避封顶",
          "description": "意图为连接时持续重试。间隔为 30、60、120、300 秒。封顶 300 秒。",
          "consequences": "网络长期不可用时仍会低频重试。用户停止后立即停止。",
          "recommended": true
        },
        {
          "id": "B",
          "label": "最多 3 次",
          "description": "3 次失败后放弃。",
          "consequences": "后台断连后可能永久不恢复。与用户要求冲突。",
          "recommended": false
        }
      ],
      "recommendation": "A",
      "affected_design_ids": [
        "R-CONN-13",
        "R-CONN-05",
        "R-CONN-06"
      ]
    },
    {
      "id": "D-04",
      "priority": "P1",
      "question": "网络离线时怎么等？",
      "reason": "离线期间的重试没有用。用户要求网络恢复后自动恢复连接。",
      "options": [
        {
          "id": "A",
          "label": "等系统网络回调",
          "description": "离线时不重试。收到网络可用回调后立即尝试一次。",
          "consequences": "网络恢复后快速重连。需要新增网络回调监听。",
          "recommended": true
        },
        {
          "id": "B",
          "label": "固定间隔重试",
          "description": "每 30 秒重试一次。",
          "consequences": "实现简单。离线期间做无效唤醒，耗电增加。",
          "recommended": false
        }
      ],
      "recommendation": "A",
      "affected_design_ids": [
        "R-NET-05",
        "R-NET-03",
        "R-CONN-04"
      ]
    },
    {
      "id": "D-05",
      "priority": "P1",
      "question": "省电在什么条件下降频？",
      "reason": "用户报告系统提示耗电较多。用户不在用时，应用不应全速计算。",
      "options": [
        {
          "id": "A",
          "label": "后台降频，熄屏再降",
          "description": "前台全速。后台停止界面探测。熄屏再降低扩展轮询频率。",
          "consequences": "锁屏耗电下降。恢复看门狗保持运行。",
          "recommended": true
        },
        {
          "id": "B",
          "label": "只在后台降频",
          "description": "后台停止界面探测。熄屏不额外降频。",
          "consequences": "实现简单。锁屏仍按后台频率运行。",
          "recommended": false
        },
        {
          "id": "C",
          "label": "不降频",
          "description": "保持现有频率。",
          "consequences": "不改动。耗电问题保留。",
          "recommended": false
        }
      ],
      "recommendation": "A",
      "affected_design_ids": [
        "R-POWER-01",
        "R-POWER-02",
        "R-CONN-11"
      ]
    }
  ],
